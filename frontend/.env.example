# Variables de entorno del frontend (configurar en Amplify).
# NO commitear valores reales con secretos.

# Endpoint del API Gateway desplegado (Output ApiUrl del stack)
VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Región AWS
VITE_AWS_REGION=us-east-1

# --- Autenticación con Amazon Cognito (federado con IAM Identity Center) ---
# Output CognitoDomain del stack (sin https://)
VITE_COGNITO_DOMAIN=datamask-339712829454.auth.us-east-1.amazoncognito.com
# Output CognitoUserPoolClientId del stack
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# URL de callback registrada en el App Client (debe terminar en /)
VITE_COGNITO_REDIRECT_URI=https://main.d3nxh77gcdsvjs.amplifyapp.com/
# Nombre del IdP SAML en Cognito (omitir hasta habilitar la federación).
# Una vez federado: IAMIdentityCenter
# VITE_COGNITO_IDP=IAMIdentityCenter
