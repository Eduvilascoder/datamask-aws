{
  "app": "npx ts-node --prefer-ts-exts bin/datamask.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "jest.config.js",
      "node_modules",
      "dist"
    ]
  },
  "profile": "masterGenAI",
  "context": {
    "account": "339712829454",
    "region": "us-east-1",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"]
  }
}
